{$CRISISPULSE_SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	@protected not path /health /api/v1/health
	basic_auth @protected {
		{$CRISISPULSE_ADMIN_USER} {$CRISISPULSE_ADMIN_PASSWORD_HASH}
	}

	route {
		@root_health path /health
		reverse_proxy @root_health api:8080

		@api path /api/*
		reverse_proxy @api api:8080

		reverse_proxy dashboard:3000
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	log {
		output stdout
		format json
	}
}
