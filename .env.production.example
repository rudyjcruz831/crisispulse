# Local no-cost smoke-test defaults. Production values are shown below each item.
CRISISPULSE_SITE_ADDRESS=http://localhost
CRISISPULSE_PUBLIC_ORIGIN=http://localhost:8088
CRISISPULSE_LOCAL_PREVIEW_ORIGIN=http://localhost:3000
CRISISPULSE_HTTP_PORT=8088
CRISISPULSE_HTTPS_PORT=8443
CRISISPULSE_LOCAL_PREVIEW_PORT=3000

# Generate a bcrypt hash with: docker run --rm -it caddy:2.10-alpine caddy hash-password
CRISISPULSE_ADMIN_USER=admin
CRISISPULSE_ADMIN_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'

CRISISPULSE_WINDOW_INTERVALS=8
CRISISPULSE_RETENTION_BYTES=10000000000
CRISISPULSE_REFRESH_WORKERS=8
CRISISPULSE_TITLE_BACKFILL_BATCH=12
CRISISPULSE_BACKUP_RETENTION_DAYS=14
CRISISPULSE_MONITOR_INTERVAL_SECONDS=60

# Optional. Leave blank to log alerts only; add a compatible HTTPS webhook later.
CRISISPULSE_ALERT_WEBHOOK_URL=

# On the paid server, use values like these:
# CRISISPULSE_SITE_ADDRESS=crisispulse.example.com
# CRISISPULSE_PUBLIC_ORIGIN=https://crisispulse.example.com
# CRISISPULSE_HTTP_PORT=80
# CRISISPULSE_HTTPS_PORT=443
